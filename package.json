{
  "name": "moss-and-ember",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A cozy 3D isometric miniature diorama and task gamification app with real GLB models, built with React, Three.js, and a task-powered coin economy.",
  "license": "MIT",
  "author": "Moss & Ember contributors",
  "keywords": [
    "threejs",
    "react-three-fiber",
    "react",
    "vite",
    "cozy",
    "miniature",
    "diorama",
    "gamification",
    "glb",
    "isometric"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "models": "bash scripts/generate_models.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "lucide-react": "^0.468.0",
    "n8ao": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "three-stdlib": "^2.35.6",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
